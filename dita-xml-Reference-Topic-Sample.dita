<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_password_policy_parameters">
  <title>Password Policy Parameters</title>
  <shortdesc>Configuration values enforced by the identity provider for all service desk agent accounts.</shortdesc>
  <refbody>
    <section>
      <title>Complexity Requirements</title>
      <table frame="all">
        <title>Password Complexity Settings</title>
        <tgroup cols="2">
          <colspec colname="col1" colwidth="1*"/>
          <colspec colname="col2" colwidth="1*"/>
          <thead>
            <row>
              <entry>Parameter</entry>
              <entry>Value</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>Minimum length</entry>
              <entry>14 characters</entry>
            </row>
            <row>
              <entry>Character classes required</entry>
              <entry>3 of 4 (upper, lower, number, symbol)</entry>
            </row>
            <row>
              <entry>Password history</entry>
              <entry>Last 10 passwords cannot be reused</entry>
            </row>
            <row>
              <entry>Maximum age</entry>
              <entry>90 days</entry>
            </row>
            <row>
              <entry>Lockout threshold</entry>
              <entry>5 failed attempts</entry>
            </row>
            <row>
              <entry>Lockout duration</entry>
              <entry>15 minutes, or administrator reset</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section>
      <title>Temporary Password Behavior</title>
      <p>Temporary passwords issued through the manual reset path expire after 24 hours if unused and always require a forced change at next login, regardless of the standard 90-day maximum age setting.</p>
    </section>
  </refbody>
</reference>
